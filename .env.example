# Database Credentials
DB_URL=jdbc:mysql://host.docker.internal:3306/mock_db?createDatabaseIfNotExist=true
DB_USERNAME=
DB_PASSWORD=

# JWT Settings
JWT_SECRET=
JWT_EXPIRATION=

# Admin Seed Account
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# API Keys
GEMINI_API_KEY=""

#Allowed origins
CORS_ALLOWED_ORIGINS=""

# Single IP or multiple allow statements
ALLOWED_DEV_IPS=allow xxx.xx.xxx.xx; allow xxx.xxx.xx.xx;

# Supabase Storage Configuration
SUPABASE_URL=https://project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET_NAME=avatars